putl.online, www.putl.online {
    handle /mcp* {
        reverse_proxy mcp-server:3001 {
            header_up X-Forwarded-Port 443
        }
    }

    handle {
        reverse_proxy frontend:80 {
            header_up X-Forwarded-Port 443
        }
    }
}

admin.putl.online {
    reverse_proxy admin-frontend:80 {
        header_up X-Forwarded-Port 443
    }
}
